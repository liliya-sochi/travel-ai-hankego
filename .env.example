APP_NAME=HankeGo
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

TELEGRAM_BOT_TOKEN=replace-with-telegram-token

BACKEND_URL=http://127.0.0.1:8000
API_PREFIX=/api/v1
INTERNAL_API_KEY=replace-with-random-string-at-least-32-characters

REDIS_URL=redis://127.0.0.1:6379/0

TRIP_PLAN_RATE_LIMIT=10
TRIP_PLAN_RATE_WINDOW_SECONDS=3600

DATABASE_URL=postgresql+asyncpg://hankego:replace-password@127.0.0.1:5433/hankego

LLM_BASE_URL=https://api.example.com/openai/v1
LLM_API_KEY=replace-with-llm-api-key
LLM_MODEL=replace-with-model-name