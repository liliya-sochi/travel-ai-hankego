APP_NAME=HankeGo
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

TELEGRAM_BOT_TOKEN=replace-with-telegram-token
MONITORING_TELEGRAM_CHAT_ID=replace-with-private-chat-id

BACKEND_URL=http://127.0.0.1:8000
API_PREFIX=/api/v1
INTERNAL_API_KEY=replace-with-random-string-at-least-32-characters

REDIS_URL=redis://127.0.0.1:6379/0

TRIP_PLAN_RATE_LIMIT=10
TRIP_PLAN_RATE_WINDOW_SECONDS=3600
TRIP_PLAN_LOCK_TTL_SECONDS=180
TRIP_INTAKE_RATE_LIMIT=60
TRIP_INTAKE_RATE_WINDOW_SECONDS=3600

# Используется контейнером PostgreSQL через Docker Compose.
POSTGRES_PASSWORD=replace-with-random-hex-string

# Используется при прямом запуске приложения без Docker.
DATABASE_URL=postgresql+asyncpg://hankego:replace-with-random-hex-string@127.0.0.1:5433/hankego

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=replace-with-groq-api-key
LLM_MODEL=openai/gpt-oss-120b

GEOAPIFY_BASE_URL=https://api.geoapify.com
GEOAPIFY_API_KEY=replace-with-geoapify-api-key
GEOAPIFY_TIMEOUT_SECONDS=30

GOOGLE_PLACES_FALLBACK_ENABLED=false
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com
GOOGLE_PLACES_API_KEY=replace-with-google-places-api-key
GOOGLE_PLACES_TIMEOUT_SECONDS=10
GOOGLE_PLACES_MONTHLY_LOOKUP_LIMIT=900
GOOGLE_PLACES_FALLBACK_LIMIT_PER_TRIP=2

TRAVEL_CONTEXT_CACHE_TTL_SECONDS=21600
