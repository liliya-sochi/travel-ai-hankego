APP_NAME=HankeGo
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

TELEGRAM_BOT_TOKEN=replace_with_your_bot_token

BACKEND_URL=http://127.0.0.1:8000
API_PREFIX=/api/v1
REDIS_URL=redis://127.0.0.1:6379/0

DATABASE_URL=postgresql+asyncpg://hankego:replace_with_password@127.0.0.1:5432/hankego

LLM_BASE_URL=https://api.example.com/openai/v1
LLM_API_KEY=replace-with-llm-api-key
LLM_MODEL=replace-with-model-name

INTERNAL_API_KEY=replace-with-random-string-at-least-32-characters

LOG_LEVEL=INFO