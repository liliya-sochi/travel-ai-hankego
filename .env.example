APP_NAME=HankeGo
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

TELEGRAM_BOT_TOKEN=replace-with-telegram-token
MONITORING_TELEGRAM_CHAT_ID=replace-with-private-chat-id

BACKEND_URL=http://127.0.0.1:8000
API_PREFIX=/api/v1
INTERNAL_API_KEY=replace-with-random-string-at-least-32-characters

REDIS_URL=redis://127.0.0.1:6379/0

TRIP_PLAN_RATE_LIMIT=10
TRIP_PLAN_RATE_WINDOW_SECONDS=3600
TRIP_PLAN_LOCK_TTL_SECONDS=180

# Используется контейнером PostgreSQL через Docker Compose.
POSTGRES_PASSWORD=replace-with-random-hex-string

# Используется при прямом запуске приложения без Docker.
DATABASE_URL=postgresql+asyncpg://hankego:replace-with-random-hex-string@127.0.0.1:5433/hankego

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=replace-with-groq-api-key
LLM_MODEL=openai/gpt-oss-120b